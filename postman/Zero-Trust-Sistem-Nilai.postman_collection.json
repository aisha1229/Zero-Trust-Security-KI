                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', function () { pm.response.to.have.status(200); });",
                  "if (pm.response.code === 200) { const d = pm.response.json(); pm.collectionVariables.set('token_admin', d.access_token); pm.collectionVariables.set('refresh_admin', d.refresh_token); }"
                ]
              }
            }
